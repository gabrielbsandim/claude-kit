#!/usr/bin/env bash
# Single entry point, so nothing that runs during a task has to know where the
# plugin was installed. Every subcommand is a sibling script.
#
#   kit config check           validate this repo's funnel config
#   kit gate <stage>           run a stage's gates, with receipts
#   kit worktree gc            remove the provably finished worktrees
#   kit review <level>         the grouped review dispatch plan
#   kit screens                routes the changed screens are reachable at
#   kit board <status> --issue N
#   kit issues related <text>  what is already on the board that overlaps this
#   kit issues orphans         open issues that are neither an epic nor a child
#   kit issues tree <n>        an epic and its children, with state
#   kit pr-body <file>         how much prose the pull request body adds
#   kit context                how full the context is, and whether to compact
#   kit usage                  what the main loop spent, and what the agents spent
#   kit doctor                 is this machine ready
#   kit version [expected]     which copy is running, and whether it is the newest
#   kit reload                 update the plugin, relink `kit`, print the restart line
#   kit setup                  put `kit` on PATH
set -euo pipefail

# Resolve symlinks by hand: `readlink -f` is GNU, and `kit setup` installs a symlink
# into ~/.local/bin, so this path runs through one every time. macOS is a target.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
KIT_BIN="$(cd -P "$(dirname "$_src")" && pwd)"
KIT_ROOT="$(dirname "$KIT_BIN")"

usage() { awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$KIT_BIN/kit"; }

# Defined here, not only in the five sibling scripts. `reload` called `die` from
# this file since 0.5.1 and it was never defined here, so the one error it can
# raise, no installed copy to relink, exited 2 with no message at all. Found by
# the test that did not exist either.
die() { printf '%s\n' "$*" >&2; exit 1; }

cmd="${1:-}"; shift || true
case "$cmd" in
  config)   exec "$KIT_BIN/funnel-config" "$@" ;;
  screens)  exec "$KIT_BIN/screen-routes" "$@" ;;
  gate)     exec "$KIT_BIN/gate" "$@" ;;
  issues)   exec "$KIT_BIN/issues" "$@" ;;
  pr-body)  exec "$KIT_BIN/pr-body" "$@" ;;
  context)  exec "$KIT_BIN/context" "$@" ;;
  usage)    exec "$KIT_BIN/usage" "$@" ;;
  worktree) exec "$KIT_BIN/worktree" "$@" ;;
  board)    exec "$KIT_BIN/board-move" "$@" ;;
  review)
    # `kit review standard` is the common case; anything starting with - passes through.
    case "${1:-}" in
      -*|"") exec "$KIT_BIN/review-package" "$@" ;;
      *) exec "$KIT_BIN/review-package" --dispatches "$@" ;;
    esac
    ;;

  # Three copies of this plugin can disagree at once, and every one of them fails
  # silently. A running session keeps the copy it loaded at startup, so its skills
  # and agents survive a `claude plugin update` untouched. `kit setup` links into a
  # version-pinned cache directory, so the executable on PATH keeps pointing at
  # whatever was newest the day it was linked. And the cache itself only moves when
  # an update runs. Measured on 2026-08-17: a funnel run executed the 0.1.0 skill
  # while 0.2.0 had been installed for five minutes, which cost a browser lens, a
  # report cap and two other rules that had already shipped.
  version|--version|-v)
    expected="${1:-}"
    manifest="$KIT_ROOT/.claude-plugin/plugin.json"
    mine="$(jq -r '.version // empty' "$manifest" 2>/dev/null || true)"
    name="$(jq -r '.name // empty' "$manifest" 2>/dev/null || true)"
    [ -n "$mine" ] || mine=unknown
    [ -n "$name" ] || name=claude-kit
    cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

    newest="" newest_root=""
    while IFS= read -r m; do
      [ -f "$m" ] || continue
      [ "$(jq -r '.name // empty' "$m" 2>/dev/null || true)" = "$name" ] || continue
      v="$(jq -r '.version // empty' "$m" 2>/dev/null || true)"
      [ -n "$v" ] || continue
      if [ -z "$newest" ] || [ "$(printf '%s\n%s\n' "$newest" "$v" | sort -V | tail -1)" = "$v" ]; then
        newest="$v"; newest_root="$(dirname "$(dirname "$m")")"
      fi
    done < <(find "$cfg/plugins" -mindepth 2 -maxdepth 6 -name plugin.json -path '*/.claude-plugin/*' 2>/dev/null || true)

    printf '%-10s %-8s %s\n' running "$mine" "$KIT_ROOT"
    if [ -n "$newest" ]; then
      printf '%-10s %-8s %s\n' installed "$newest" "$newest_root"
    else
      printf '%-10s %-8s no installed copy under %s\n' installed none "$cfg/plugins"
    fi
    [ -n "$expected" ] && printf '%-10s %-8s declared by the caller\n' caller "$expected"

    stale=0
    newer_than() { # is $2 strictly newer than $1
      [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$2" ]
    }
    if [ -n "$newest" ] && [ -n "$expected" ] && newer_than "$expected" "$newest"; then
      printf 'STALE SKILL   the caller is %s and %s is installed. A running session keeps the\n' "$expected" "$newest"
      printf '              plugin copy it loaded at startup, so restart the session; an update alone\n'
      printf '              does not reach it.\n'
      stale=1
    fi
    if [ -n "$newest" ] && [ "$mine" != unknown ] && newer_than "$mine" "$newest"; then
      printf 'STALE KIT     this executable is %s and %s is installed. `kit setup` links a\n' "$mine" "$newest"
      printf '              version-pinned path, so run it again: %s/bin/kit setup\n' "$newest_root"
      stale=1
    fi
    [ $stale -eq 0 ] && printf 'up to date\n'
    exit $((stale * 3))
    ;;

  # The two halves of "make this machine current", in the order they can be done.
  # There is no third half: `claude plugin update` prints "restart required to
  # apply", and a session cannot restart itself, so the last step is one line the
  # user runs in their own terminal. Printing it beats pretending.
  reload)
    id="${CLAUDE_KIT_PLUGIN_ID:-claude-kit@claude-kit}"
    name="${id%@*}"
    cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    target="${1:-$HOME/.local/bin}"

    before="$(ls -d "$cfg"/plugins/cache/*/"$name"/*/ 2>/dev/null | sed 's|/$||;s|.*/||' | sort -V | tail -1 || true)"
    if command -v claude >/dev/null; then
      claude plugin update "$id" -y 2>&1 | tail -2
    else
      printf 'claude is not on PATH, so the update half cannot run here\n' >&2
    fi
    after="$(ls -d "$cfg"/plugins/cache/*/"$name"/*/ 2>/dev/null | sed 's|/$||;s|.*/||' | sort -V | tail -1 || true)"
    [ -n "$after" ] || die "no installed copy of $name under $cfg/plugins"

    root="$(ls -d "$cfg"/plugins/cache/*/"$name"/"$after"/ 2>/dev/null | head -1 || true)"
    "$root/bin/kit" setup "$target" >/dev/null
    printf '\nkit        %s  (relinked, live now)\n' "$after"

    if [ "$before" != "$after" ]; then
      printf 'plugin     %s -> %s on disk\n' "${before:-none}" "$after"
      # This block said "the skills and agents in THIS session are still <old>", and
      # the skills half was wrong. Measured on 2026-08-17 in one session that never
      # restarted: /claude-kit:task loaded its SKILL.md from 0.1.0 at 14:11, from
      # 0.1.1 at 19:03 and from 0.3.1 at 23:16. The body of a skill is re-read at
      # each invocation. Telling somebody to restart for a reason that is not real
      # is how the real reasons stop being believed.
      printf '\nLive already, no restart:\n'
      printf '  bin/, including kit itself, resolved on PATH when it runs\n'
      printf '  a skill body, re-read from the newest copy at each invocation\n'
      printf '\nWaiting on a restart:\n'
      printf '  the output style, read into the system prompt once at boot\n'
      printf '  hooks, registered from settings.json at session start\n'
      printf '  the skill and agent listing, and agent definitions (INFERRED)\n'
      printf '\n  exec claude -c\n\n'
      printf 'In your terminal, not inside the session: it replaces the process and\n'
      printf 'keeps this conversation.\n'
    else
      printf 'plugin     %s, already the newest\n' "$after"
    fi
    ;;

  setup)
    target="${1:-$HOME/.local/bin}"
    mkdir -p "$target"
    ln -sf "$KIT_BIN/kit" "$target/kit"
    printf 'linked %s -> %s\n' "$target/kit" "$KIT_BIN/kit"
    case ":$PATH:" in
      *":$target:"*) printf 'PATH already contains %s\n' "$target" ;;
      *) printf 'Add this to your shell profile:\n  export PATH="%s:$PATH"\n' "$target" ;;
    esac
    ;;

  doctor)
    status=0
    printf 'kit      %s\n' "$KIT_ROOT"
    for c in git jq; do
      if command -v "$c" >/dev/null; then printf '%-8s %s\n' "$c" "$(command -v "$c")"
      else printf '%-8s MISSING, required\n' "$c" >&2; status=1; fi
    done
    for c in gh az curl; do
      if command -v "$c" >/dev/null; then printf '%-8s %s\n' "$c" "$(command -v "$c")"
      else printf '%-8s not installed, only needed by its board adapter\n' "$c"; fi
    done
    if command -v gh >/dev/null; then
      if gh auth status >/dev/null 2>&1; then
        scopes="$(gh auth status 2>&1 | sed -n 's/.*Token scopes: //p' | head -1)"
        printf 'gh auth  ok, scopes %s\n' "$scopes"
        case "$scopes" in
          *project*) ;;
          *) printf 'gh auth  no "project" scope, GitHub Projects moves will fail: gh auth refresh -s project\n' >&2; status=1 ;;
        esac
      else
        printf 'gh auth  not logged in\n' >&2; status=1
      fi
    fi
    if git rev-parse --show-toplevel >/dev/null 2>&1; then
      printf '\nrepo     %s\n' "$("$KIT_BIN/funnel-config" root)"
      "$KIT_BIN/funnel-config" check || status=1
    else
      printf '\nnot inside a git repository, so the repo half of the check is skipped\n'
    fi
    exit $status
    ;;

  ""|-h|--help|help) usage ;;
  *) printf 'unknown subcommand: %s\n\n' "$cmd" >&2; usage >&2; exit 1 ;;
esac
