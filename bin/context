#!/usr/bin/env python3
"""How full this session's context is, and whether to compact yet.

    kit context [--window N] [--project DIR] [--session ID] [--json]

Compacting is cheap and rewriting a large prefix is expensive, and the second one
is not a choice you make. Measured across 16 sessions from 2026-08-11 to
2026-08-18, at API-equivalent rates: US$ 2442 total, of which **US$ 393, 16%, went
to requests that read almost nothing from cache and wrote a whole prefix back**.
1.4% of requests carried 15% of the cost in the worst session, at US$ 2.62 each
against US$ 0.20 for a normal one. The largest single prefix rewrite was 863,397
tokens in one request.

So the point of compacting is not the cheaper reads afterwards. It is that the
rewrite which will happen anyway is smaller when it does.

**The trigger is the end of a unit of work, and the threshold is a prefix size,
not a share of the window.** Compacting mid-task trades a dollar for file re-reads
that cost more and come back worse, so the boundary is what fires it. But how
urgent the next boundary is depends on how many tokens every turn is now re-reading,
and that is an absolute number: the same 300k prefix costs the same on a 200k
window and a 1M one. Until 0.10.0 these bands were percentages of the window, which
on 1M put a session that peaked at 507k tokens in HOLD for its entire life.

One case ignores the percentage entirely: **compact before a long pause.** In the
session measured on Bedrock, 116 of 152 prefix rewrites followed a gap of 5 to 60
minutes and 26 followed more than an hour, at a median of 301,026 tokens and
US$ 1.89 each. That session was not getting the one-hour cache TTL, so every
coffee break rewrote everything. A pause with a large prefix is the only place a
single request costs five dollars.

Finds its own session through `CLAUDE_CODE_SESSION_ID`, which the harness exports
into every command it runs, so the answer is about the session asking rather than
about whichever transcript was written to last. Without that variable it falls back
to the newest transcript for the current directory's project and says so, because a
number attributed to the wrong session is worse than no number.
"""

import argparse
import glob
import json
import os
import sys

# Opus and Sonnet 5 are 1M; Haiku 4.5 is 200k. Passed in rather than detected,
# because the id in a transcript is the model of one request and a session can
# change model mid-run.
DEFAULT_WINDOW = 1_000_000

# The bands, on the prefix itself. Measured 2026-08-29 over 988 transcripts: the
# median session peaked at 260,253 tokens of context, the p90 at 506,574 and the
# largest at 654,359. Against a 1M window those are 74%, 49% and 35% free, so the
# old percentage bands answered HOLD or AT THE NEXT BOUNDARY for essentially every
# session ever run, and HOLD is the one verdict that is never actionable.
#
# What makes a threshold arguable is payback, not proportion. A turn whose prefix
# is P tokens pays P x US$ 0.50/M just to read it back. Compacting costs one prefix
# rewrite, measured at US$ 0.4389 for the turn following a compaction against
# US$ 0.1346 for a normal one across 35,583 main-loop turns, so about US$ 0.30
# extra, and it resets the prefix to roughly 40k. Compacting at P therefore pays
# for itself in 0.30 / ((P - 40_000) x 0.5e-6) turns:
#
#     P = 120k    about 8 turns
#     P = 250k    about 3 turns
#     P = 400k    under 2 turns
#
# Sessions run into the hundreds of turns, so past 250k the compaction has paid for
# itself before the next gate finishes. What it does not pay for is a redo, which is
# why the trigger is still the end of a unit of work: NOW means the next boundary
# you reach, not this line of the diff.
BANDS_TOKENS = (
    (300_000, "NOW", "compact at the very next boundary, and take one if none is close"),
    (120_000, "AT THE NEXT BOUNDARY", "compact when the current unit of work ends, do not let it slide"),
    (0, "HOLD", "no routine compaction; compact only if you are stopping"),
)

# The one band that is still a percentage, because what it describes is the
# automatic compaction, and that fires against the window rather than against a
# token count.
LATE_FREE_PCT = 15

# Per million tokens. Cache write is 1.25x input at the 5-minute TTL, cache read is
# 0.1x. Matched on a substring of the model id rather than on an exact name, so a
# point release does not silently fall back to the wrong tier.
PRICES = {
    "opus": {"in": 5.0, "out": 25.0, "cw": 6.25, "cr": 0.50},
    "sonnet": {"in": 2.0, "out": 10.0, "cw": 2.50, "cr": 0.20},
    "haiku": {"in": 1.0, "out": 5.0, "cw": 1.25, "cr": 0.10},
}
# The default when a request names no model, and the tier this command's own prose
# quotes. Opus rather than an average: over-reporting a saving is the failure mode
# that matters here.
RATES = PRICES["opus"]


def rates_for(model):
    name = (model or "").lower()
    if "haiku" in name:
        return PRICES["haiku"]
    if "sonnet" in name:
        return PRICES["sonnet"]
    return PRICES["opus"]


def cost(u, model=None):
    """One request's list price, at the tier its own model is billed at.

    A single Opus rate was close enough while every agent inherited the main loop's
    model. It stopped being close enough in 0.10.0, when the test writer and the
    reviewer moved to Sonnet: priced as Opus, a Sonnet stage reports about 2.5 times
    what it costs, which is exactly the number somebody would be reading to decide
    whether moving it was worth doing.
    """
    rates = rates_for(model if model is not None else u.get("_model"))
    return (
        u.get("input_tokens", 0) * rates["in"]
        + u.get("output_tokens", 0) * rates["out"]
        + u.get("cache_creation_input_tokens", 0) * rates["cw"]
        + u.get("cache_read_input_tokens", 0) * rates["cr"]
    ) / 1e6


def slug_for(path):
    """The directory name Claude Code derives from a working directory."""
    return "-" + path.strip("/").replace("/", "-")


def find_session(cfg, session):
    """A named session, looked for under every project rather than one.

    Not scoped to the current directory's project: a session started elsewhere is
    exactly the one somebody names by hand, and scoping it there answered "no
    transcript" for a file that existed.
    """
    hits = sorted(glob.glob(os.path.join(cfg, "projects", "*", session + "*.jsonl")))
    return hits[0] if hits else None


def newest_transcript(project_dir):
    hits = glob.glob(os.path.join(project_dir, "*.jsonl"))
    return max(hits, key=os.path.getmtime) if hits else None


def read_usage(path):
    """Every request's usage, in order, deduplicated by request and message id."""
    out = []
    seen = set()
    with open(path, errors="ignore") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                row = json.loads(line)
            except ValueError:
                continue
            message = row.get("message") or {}
            usage = message.get("usage")
            if not usage:
                continue
            key = (row.get("requestId"), message.get("id"))
            if key in seen:
                continue
            seen.add(key)
            # The model and the timestamp travel with the usage under private keys,
            # because a caller pricing a whole period needs both and the alternative
            # is a second pass over the same file. Summing code that walks the known
            # token keys is unaffected.
            usage["_model"] = message.get("model")
            usage["_ts"] = row.get("timestamp") or ""
            out.append(usage)
    return out


def is_rewrite(u):
    """Read almost nothing, wrote a whole prefix back.

    Both halves matter. A large `cache_creation` alone is ordinary growth as the
    conversation extends; it is the collapsed `cache_read` beside it that says the
    prefix missed rather than grew.
    """
    return (
        u.get("cache_read_input_tokens", 0) < 50_000
        and u.get("cache_creation_input_tokens", 0) > 100_000
    )


def band(used, free_pct):
    if free_pct <= LATE_FREE_PCT:
        return "LATE", "the automatic one fires around here and picks the cut point for you"
    for floor, verdict, advice in BANDS_TOKENS:
        if used > floor:
            return verdict, advice
    return BANDS_TOKENS[-1][1], BANDS_TOKENS[-1][2]


def payback_turns(used):
    """How many turns of cheaper reads repay one compaction at this prefix.

    None when the prefix is already small enough that the arithmetic says nothing:
    below the reset size there is no saving to divide by.
    """
    saved = (used - 40_000) * 0.5e-6
    return 0.30 / saved if saved > 0 else None


def main(argv):
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--window", type=int, default=int(os.environ.get("KIT_CONTEXT_WINDOW", DEFAULT_WINDOW)))
    ap.add_argument("--project")
    ap.add_argument("--session")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args(argv)

    if args.help:
        print(__doc__)
        return 0

    cfg = os.environ.get("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude"))
    wanted = args.session or os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    guessed = False

    path = find_session(cfg, wanted) if wanted else None
    if not path:
        guessed = bool(wanted)
        project = args.project or os.path.join(cfg, "projects", slug_for(os.getcwd()))
        if not os.path.isdir(project):
            print(f"no transcripts for this directory under {project}", file=sys.stderr)
            return 2
        path = newest_transcript(project)
        if not path:
            print(f"no transcript in {project}", file=sys.stderr)
            return 2

    reqs = read_usage(path)
    if not reqs:
        print(f"no requests recorded in {os.path.basename(path)}", file=sys.stderr)
        return 2

    last = reqs[-1]
    # What the next request will have to read: everything cached plus what this
    # one just added. This is the number the prefix rewrite would be charged on.
    used = last.get("cache_read_input_tokens", 0) + last.get("cache_creation_input_tokens", 0)
    free_pct = max(0, round((args.window - used) * 100 / args.window))
    verdict, advice = band(used, free_pct)
    payback = payback_turns(used)

    rewrites = [u for u in reqs if is_rewrite(u)]
    spent = sum(cost(u) for u in reqs)
    burned = sum(cost(u) for u in rewrites)
    # What one rewrite would cost at the current size, which is the number that
    # makes the verdict an argument rather than a preference.
    at_risk = used * RATES["cw"] / 1e6

    if args.json:
        print(json.dumps({
            "session": os.path.splitext(os.path.basename(path))[0][:8], "window": args.window,
            "used": used, "free_pct": free_pct, "verdict": verdict,
            "payback_turns": round(payback, 1) if payback else None,
            "requests": len(reqs), "rewrites": len(rewrites),
            "spent": round(spent, 2), "burned_on_rewrites": round(burned, 2),
            "one_rewrite_now": round(at_risk, 2),
        }))
        return 0

    # The id, without the extension: a short filename truncated to eight characters
    # printed "edge2.js" as if it were a session id.
    who = os.path.splitext(os.path.basename(path))[0][:8]
    tag = f"session {who}" + ("  (guessed: the named session has no transcript yet)" if guessed else "")
    print(f"{verdict}  {free_pct}% of the window free, {used:,} of {args.window:,} in context")
    print(f"  {tag}")
    print(f"  {advice}")
    print(f"  a prefix rewrite at this size would cost about US$ {at_risk:.2f} in one request")
    if payback:
        turns = max(1, round(payback))
        print(f"  compacting here repays itself in about {turns} "
              f"{'turn' if turns == 1 else 'turns'} of cheaper reads")
    share = f", {burned / spent * 100:.0f}% of it" if spent else ""
    print(f"  this session: {len(reqs)} requests, {len(rewrites)} rewrites, "
          f"US$ {spent:.2f} at API rates and US$ {burned:.2f} on rewrites{share}")
    print("  and whatever the percentage says, compact before a long pause")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
