#!/usr/bin/env python3
"""Board questions a funnel run has to answer before it creates another issue.

    issues related <text> [--files a,b] [--parent N] [--limit 5]
    issues orphans [--label L]
    issues tree <number>

Why this is a command and not a paragraph in a skill: "check whether a similar
issue already exists" is the kind of instruction that reads as done and gets
skipped, and skipping it is invisible. Measured on 2026-08-17 in the repository
this was written against: eleven security issues opened in two days, nine of them
correctly linked under their parent, and the only two orphans were the two created
as findings in the middle of a task. An orphan is what turns an epic with children
into a flat list that looks like it grows forever.

`related` scores by evidence a reader can check, not by a similarity a model
asserts:

- file paths the two bodies both name, which is the strongest signal and the one
  that decides whether two issues are one pull request,
- identifiers in backticks, which catch two issues about the same function under
  different prose,
- title tokens, with the repo's own prefixes (`fix`, `feat`, `security`) treated
  as stopwords because otherwise every issue matches every other issue,
- labels, which are weak on their own and only break ties.

Reads the tracker through `gh`. Other providers print what they cannot do instead
of returning an empty list, because an empty list reads as "nothing similar" and
that is the one wrong answer here. `--json <file>` reads issues from a file, which
is how the tests run with no network.
"""
import argparse
import json
import math
import os
import re
import subprocess
import sys

PATH_RE = re.compile(r"(?:src|docs|prisma|scripts|tests|lib|app|packages)/[A-Za-z0-9_./\[\]@-]+\.[a-z]{1,5}")
CODE_RE = re.compile(r"`([A-Za-z_][A-Za-z0-9_.]{2,})`")
TOKEN_RE = re.compile(r"[a-z0-9]{3,}")

# Every issue in a repo that uses conventional prefixes carries these, so scoring
# them makes everything look related to everything.
STOP = {
    "fix", "feat", "chore", "refactor", "docs", "test", "perf", "build", "security",
    "the", "and", "for", "not", "with", "from", "that", "this", "was", "are", "its",
    "que", "com", "para", "nao", "não", "por", "uma", "dos", "das", "sem", "mais",
    "esta", "está", "está", "ser", "tem", "todo", "toda", "onde", "quem", "isso",
    "issue", "epic", "fatia", "slice", "mecanismo", "mechanism",
}


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def repo_root():
    here = os.path.dirname(os.path.abspath(__file__))
    out = subprocess.run([os.path.join(here, "funnel-config"), "root"],
                         capture_output=True, text=True)
    return out.stdout.strip() or os.getcwd()


def provider():
    here = os.path.dirname(os.path.abspath(__file__))
    board = os.path.join(repo_root(), ".claude", "board.json")
    if not os.path.exists(board):
        return "none"
    try:
        with open(board) as fh:
            return json.load(fh).get("provider", "none")
    except (OSError, ValueError):
        return "none"


def gh_json(args):
    out = subprocess.run(["gh"] + args, capture_output=True, text=True)
    if out.returncode != 0:
        die("gh failed: %s" % (out.stderr.strip() or "no output"))
    return json.loads(out.stdout or "[]")


def load_issues(from_file, limit=400):
    """Open issues with the fields the scorer needs, or a fixture for the tests."""
    if from_file:
        with open(from_file) as fh:
            return json.load(fh)
    p = provider()
    if p not in ("github-projects-v2", "github", "none"):
        die("issue search is implemented for GitHub only, and this repo's board is "
            "\"%s\". Search that board by hand before creating anything: an empty "
            "answer here would read as \"nothing similar exists\"." % p, 2)
    return gh_json(["issue", "list", "--state", "open", "--limit", str(limit),
                    "--json", "number,title,body,labels"])


def features(text):
    files = set(PATH_RE.findall(text or ""))
    code = set(m.lower() for m in CODE_RE.findall(text or ""))
    return files, code


def title_tokens(title):
    return {t for t in TOKEN_RE.findall((title or "").lower()) if t not in STOP}


def document_frequency(issues):
    """How many open issues mention each file, identifier and title word.

    Without this the ranking is decided by whatever every issue happens to name.
    Measured on the board this was written against: `docs/security.md` appears in 6
    of 14 open issues and the word "obra" in most of them, so an unweighted score
    put an unrelated NFS-e issue at the top of a permissions query. A term shared by
    everything distinguishes nothing.
    """
    df = {}
    for i in issues:
        f, c = features(i.get("body", ""))
        for term in f | c | title_tokens(i.get("title", "")):
            df[term] = df.get(term, 0) + 1
    return df


DOC_RE = re.compile(r"(^docs/|\.mdx?$)")


def weight(term, df, n):
    """Rarity, floored at zero so a term in every issue cannot lift a score.

    Documentation paths are damped to a fifth. In a repo where a change updates the
    document it contradicts, two issues naming the same document is the normal case
    and says nothing about whether they are the same work: `docs/security.md` is
    named by 8 of 17 open issues here. Damping is what keeps a document-only overlap
    from outranking a source-file overlap of the same rarity. It is not what decides
    the verdict, which ignores documents outright, because damping a score still
    leaves it above zero and two issues that both edit a document are still just two
    issues that both edit a document.
    """
    seen = df.get(term, 0)
    if seen >= n or n <= 1:
        return 0.0
    w = math.log(n / max(seen, 1))
    return w * 0.2 if DOC_RE.search(term) else w


def score(target, issue, df, n):
    """Rarity-weighted evidence overlap. Returns the score and what matched."""
    tf, tc = target["files"], target["code"]
    isf, isc = features(issue.get("body", ""))
    it = title_tokens(issue.get("title", ""))
    il = {l["name"] for l in (issue.get("labels") or [])}

    same_files = tf & isf
    same_code = (tc & isc) - {f.lower() for f in same_files}
    same_tokens = target["tokens"] & it
    same_labels = target["labels"] & il

    s = (5 * sum(weight(f, df, n) for f in same_files)
         + 2 * sum(weight(c, df, n) for c in same_code)
         + sum(weight(t, df, n) for t in same_tokens)
         + 0.25 * len(same_labels))
    # The verdict counts source files only, and only ones few other issues name.
    # Two issues that both edit a document are two issues that both edit a document.
    distinctive = sorted(f for f in same_files
                         if not DOC_RE.search(f) and df.get(f, 0) <= max(2, n // 8))
    # The term itself is the second key, not decoration: rarity ties are the common
    # case, and sorting a set by rarity alone leaves the order to the process's hash
    # seed, so the same query printed a different evidence order on every run.
    def by_rarity(x):
        return (-weight(x, df, n), x)

    return s, {
        "files": sorted(same_files, key=by_rarity),
        "distinctive": distinctive,
        "code": sorted(same_code, key=by_rarity),
        "tokens": sorted(same_tokens, key=by_rarity),
        "labels": sorted(same_labels),
    }


def sub_issues(number):
    """Parent and children, which is the only way to see an epic as a tree."""
    q = ("{repository(owner:\"%s\",name:\"%s\"){issue(number:%d){number title state "
         "parent{number title} subIssues(first:50){totalCount nodes{number title state}}}}}")
    nwo = subprocess.run(["gh", "repo", "view", "--json", "owner,name"],
                         capture_output=True, text=True)
    if nwo.returncode != 0:
        die("gh repo view failed: %s" % nwo.stderr.strip())
    meta = json.loads(nwo.stdout)
    out = subprocess.run(["gh", "api", "graphql", "-f",
                          "query=" + q % (meta["owner"]["login"], meta["name"], number)],
                         capture_output=True, text=True)
    if out.returncode != 0:
        die("gh api graphql failed: %s" % out.stderr.strip())
    node = json.loads(out.stdout)["data"]["repository"]["issue"]
    if node is None:
        die("#%d is not an issue in this repository (a pull request has no sub-issues)" % number)
    return node


def cmd_related(a):
    issues = load_issues(a.json)
    files = set(x.strip() for x in (a.files or "").split(",") if x.strip())
    target = {
        "files": files | set(PATH_RE.findall(a.text)),
        "code": set(m.lower() for m in CODE_RE.findall(a.text)),
        "tokens": title_tokens(a.text),
        "labels": set(x.strip() for x in (a.labels or "").split(",") if x.strip()),
    }
    others = [i for i in issues if not (a.exclude and i.get("number") == a.exclude)]
    df = document_frequency(others)
    n = max(len(others), 1)
    ranked = []
    for i in others:
        s, why = score(target, i, df, n)
        if s > 0.5:
            ranked.append((s, i, why))
    ranked.sort(key=lambda r: (-r[0], r[1].get("number", 0)))

    print("target   files=%d code=%d tokens=%d  corpus=%d open" % (
        len(target["files"]), len(target["code"]), len(target["tokens"]), n))
    if not ranked:
        print("no open issue shares a distinctive file, identifier or word with this.")
        print("verdict  nothing to merge into. If you create it, give it a parent.")
        return 0
    shown = ranked[: a.limit]
    for s, i, why in shown:
        print("\n#%-5s %5.1f  %s" % (i["number"], s, (i.get("title") or "")[:72]))
        for k in ("files", "code", "tokens"):
            if why[k]:
                print("   %-7s %s" % (k, ", ".join(why[k][:6])))
    top_s, top_i, top_w = shown[0]
    dist = top_w["distinctive"]
    # Two files that few other issues name is the same work. One is worth reading
    # first. Wording alone is a different task with a similar subject, which is the
    # normal case in a repo where every issue starts with the same prefix.
    if len(dist) >= 2:
        print("\nverdict  #%s shares %d distinctive file(s): %s." % (
            top_i["number"], len(dist), ", ".join(dist[:4])))
        print("         Treat it as the same work: comment there, or deliver both in one")
        print("         pull request rather than opening a second issue.")
    elif dist:
        print("\nverdict  #%s also touches %s. Read it before creating anything." % (
            top_i["number"], dist[0]))
    else:
        print("\nverdict  overlap is wording only, so probably a different task.")
        print("         If you create it, give it a parent.")
    if a.parent:
        tree = sub_issues(a.parent)
        kids = tree["subIssues"]["nodes"]
        print("\nparent   #%s %s" % (tree["number"], (tree["title"] or "")[:60]))
        for k in kids:
            print("   #%-5s %-6s %s" % (k["number"], k["state"].lower(), (k["title"] or "")[:60]))
        if not kids:
            print("   (no children yet)")
    return 0


def cmd_orphans(a):
    issues = load_issues(a.json)
    if a.label:
        want = set(x.strip() for x in a.label.split(","))
        issues = [i for i in issues if want & {l["name"] for l in (i.get("labels") or [])}]
    if a.json:
        die("orphans needs the tracker: the parent link is not in the issue list payload", 2)
    orphans = []
    for i in issues:
        node = sub_issues(i["number"])
        if node["parent"] is None and node["subIssues"]["totalCount"] == 0:
            orphans.append(i)
    print("open=%d  orphans=%d" % (len(issues), len(orphans)))
    for i in orphans:
        print("#%-5s %s" % (i["number"], (i.get("title") or "")[:74]))
    if orphans:
        print("\nAn orphan is neither an epic nor a child, so the board shows it as a flat")
        print("row. Adopt it under the epic it belongs to, or say in the issue why it")
        print("stands alone.")
    return 0


def cmd_tree(a):
    node = sub_issues(a.number)
    par = node["parent"]
    print("#%-5s %-6s %s" % (node["number"], node["state"].lower(), (node["title"] or "")[:70]))
    if par:
        print("parent   #%s %s" % (par["number"], (par["title"] or "")[:62]))
    kids = node["subIssues"]["nodes"]
    if not kids:
        print("children none")
        return 0
    open_n = sum(1 for k in kids if k["state"].lower() == "open")
    print("children %d, %d open" % (len(kids), open_n))
    for k in kids:
        sub = sub_issues(k["number"])
        n = sub["subIssues"]["totalCount"]
        print("  #%-5s %-6s %s%s" % (k["number"], k["state"].lower(),
                                     (k["title"] or "")[:62],
                                     "  (+%d children)" % n if n else ""))
    return 0


def main():
    ap = argparse.ArgumentParser(add_help=False)
    sub = ap.add_subparsers(dest="cmd")

    r = sub.add_parser("related", add_help=False)
    r.add_argument("text")
    r.add_argument("--files", default="")
    r.add_argument("--labels", default="")
    r.add_argument("--parent", type=int)
    r.add_argument("--exclude", type=int)
    r.add_argument("--limit", type=int, default=5)
    r.add_argument("--json")
    r.set_defaults(fn=cmd_related)

    o = sub.add_parser("orphans", add_help=False)
    o.add_argument("--label", default="")
    o.add_argument("--json")
    o.set_defaults(fn=cmd_orphans)

    t = sub.add_parser("tree", add_help=False)
    t.add_argument("number", type=int)
    t.set_defaults(fn=cmd_tree)

    if len(sys.argv) == 1 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.split("\n\n")[1].strip())
        return 0
    a = ap.parse_args()
    if not getattr(a, "fn", None):
        die("usage: issues related <text> | issues orphans | issues tree <n>")
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
