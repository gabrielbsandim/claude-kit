{
  "description": "Two guards the funnel depends on: secrets never reach a transcript, and a green suite cannot be faked. The em dash hook ships alongside but is not registered, because it is a house style rather than a correctness property.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/env-guard.py\""
          },
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/protect-tests.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/protect-tests.py\""
          }
        ]
      }
    ]
  }
}
