{
  "$schema": "https://raw.githubusercontent.com/gabrielbsandim/claude-kit/main/templates/funnel.schema.json",

  "base": "develop",

  "docs": {
    "entry": "AGENTS.md",
    "pipeline": "docs/pipeline.md",
    "commits": "docs/commit-conventions.md"
  },

  "branch": {
    "pattern": "{prefix}/{issue}-{slug}",
    "prefix": { "feature": "feat", "bug": "fix", "refactor": "refactor", "chore": "chore" }
  },

  "worktree": {
    "path": "../{repo}-{issue}",
    "setup": ["npm ci", "npx prisma generate"],
    "skipSetupWhenDocOnly": true
  },

  "gates": {
    "lint": { "cmd": "npm run check" },
    "types": { "cmd": "npx tsc --noEmit" },
    "test": { "cmd": "npm test" },
    "test_changed": { "cmd": "npx vitest run --changed {base}" },
    "coverage": { "cmd": "npm run test:coverage" }
  },

  "stages": {
    "implement_first_pass": ["lint", "types", "test"],
    "implement_fix_round": ["types", "test_changed"],
    "tests": ["test"],
    "ship": ["lint", "types", "test", "coverage"]
  },

  "slices": {
    "src": "{base}...HEAD -- src ':(exclude)src/tests'",
    "tests": "{base}...HEAD -- src/tests",
    "surfaces": "{base}...HEAD -- docs src/lib/helpContent.ts src/lib/knowledge",
    "all": "{base}...HEAD"
  },

  "lenses": {
    "correctness": { "slice": "src", "docs": [] },
    "conventions": {
      "slice": "src",
      "docs": ["docs/architecture.md", "docs/conventions.md", "docs/frontend.md"]
    },
    "failure-edges": { "slice": "src", "docs": [] },
    "security": { "slice": "src", "docs": ["docs/security.md"] },
    "tests": { "slice": "tests", "docs": ["docs/testing.md"] },
    "surfaces": { "slice": "surfaces", "docs": [] },
    "claims": {
      "slice": "all",
      "docs": [],
      "grepTargets": ["docs", "src/lib/helpContent.ts", "src/lib/knowledge"]
    }
  },

  "effort": {
    "light": ["correctness"],
    "standard": ["correctness", "conventions", "tests", "claims"],
    "deep": [
      "correctness",
      "conventions",
      "failure-edges",
      "security",
      "tests",
      "surfaces",
      "claims"
    ]
  },

  "maxRounds": 2,
  "maxParallelAgents": 3,

  "flaky": [
    {
      "file": "src/tests/components/Modal.test.tsx",
      "issue": "512",
      "why": "intermittent, unrelated to any diff"
    }
  ],

  "board": ".claude/board.json"
}
