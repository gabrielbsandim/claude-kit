{
  "$schema": "https://raw.githubusercontent.com/gabrielbsandim/task-funnel/main/templates/funnel.schema.json",
  "base": "develop",
  "docs": {
    "entry": "AGENTS.md",
    "pipeline": "docs/pipeline.md",
    "commits": "docs/commit-conventions.md"
  },
  "branch": {
    "pattern": "{prefix}/{issue}-{slug}",
    "prefix": {
      "feature": "feat",
      "bug": "fix",
      "refactor": "refactor",
      "chore": "chore"
    }
  },
  "worktree": {
    "path": "../{repo}-{issue}",
    "setup": [
      "npm ci",
      "npx --no-install prisma generate"
    ],
    "skipSetupWhenDocOnly": true
  },
  "gates": {
    "lint": {
      "cmd": "npm run check"
    },
    "types": {
      "cmd": "npx --no-install tsc --noEmit"
    },
    "test": {
      "cmd": "npm test"
    },
    "test_changed": {
      "cmd": "npx --no-install vitest run --changed {base}"
    },
    "coverage": {
      "cmd": "npm run test:coverage",
      "covers": [
        "test"
      ]
    }
  },
  "stages": {
    "implement_first_pass": [
      "lint",
      "types",
      "test"
    ],
    "implement_fix_round": [
      "types",
      "test_changed"
    ],
    "tests": [
      "coverage"
    ],
    "ship": [
      "lint",
      "types",
      "coverage"
    ]
  },
  "slices": {
    "src": "{base}...HEAD -- src ':(exclude)src/tests'",
    "tests": "{base}...HEAD -- src/tests",
    "surfaces": "{base}...HEAD -- docs README.md",
    "all": "{base}...HEAD"
  },
  "lenses": {
    "correctness": {
      "slice": "src",
      "docs": []
    },
    "tests": {
      "slice": "tests",
      "docs": [
        "docs/testing.md"
      ]
    },
    "surfaces": {
      "slice": "surfaces",
      "docs": []
    },
    "claims": {
      "slice": "all",
      "docs": [],
      "grepTargets": [
        "docs",
        "README.md"
      ]
    },
    "consequences": {
      "slice": "src",
      "docs": [],
      "readsOutsideDiff": true,
      "codeTargets": [
        "src"
      ]
    }
  },
  "effort": {
    "light": [
      "correctness"
    ],
    "standard": [
      "correctness",
      "tests",
      "claims"
    ],
    "deep": [
      "correctness",
      "tests",
      "claims",
      "surfaces",
      "consequences"
    ]
  },
  "reviewModel": {
    "deep": "opus"
  },
  "lanes": {
    "direct": {
      "effort": "light",
      "maxRounds": 1
    },
    "risk": {
      "effort": "deep",
      "maxRounds": 2
    }
  },
  "risk": {
    "paths": [
      "prisma/*",
      "*/auth/*",
      "*/permissions/*",
      "*/billing/*",
      "*/payments/*",
      "src/app/api/*"
    ],
    "lenses": [
      "consequences"
    ]
  },
  "reviewGuide": "docs/review.md",
  "maxRounds": 2,
  "ledger": false,
  "maxParallelAgents": 3,
  "browser": {
    "enabled": false,
    "baseUrl": "http://localhost:3000",
    "start": "npm run dev",
    "readyPath": "/",
    "readyTimeout": 180,
    "artifactsDir": ".playwright-mcp",
    "efforts": [
      "standard",
      "deep"
    ],
    "appDir": "src/app",
    "entryFiles": [
      "page.tsx",
      "page.ts",
      "page.jsx",
      "page.js"
    ],
    "screenGlobs": [
      "src/app/**",
      "src/features/**",
      "src/components/**"
    ],
    "excludeGlobs": [
      "src/app/api/**",
      "*/tests/*",
      "*.test.*",
      "*.spec.*"
    ],
    "routeParams": {},
    "routes": {},
    "maxRoutes": 6,
    "viewports": [
      {
        "name": "mobile",
        "width": 390,
        "height": 844
      },
      {
        "name": "desktop",
        "width": 1440,
        "height": 900
      }
    ],
    "auth": {
      "loginPath": "/login",
      "userEnv": "",
      "passEnv": ""
    },
    "uxDocs": []
  },
  "flaky": [],
  "board": ".claude/board.json"
}
