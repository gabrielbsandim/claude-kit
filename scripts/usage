#!/usr/bin/env python3
"""Where a session's tokens went: the main loop, or the agents it dispatched.

    kit usage [--session ID] [--project DIR] [--all] [--json]
              [--since YYYY-MM-DD] [--until YYYY-MM-DD] [--by-stage] [--by-session]
              [--by-branch]

`ccusage` answers what a day cost and which model spent it. What it does not
answer, and what decides whether a stage is worth its model, is the split between
the session you are talking to and the agents it dispatched. That split lives in
the file layout: a subagent gets its own transcript under
`<project>/<session>/subagents/agent-*.jsonl`, and its usage is never written into
the parent.

Measured across every transcript on the machine this was written on, 2026-08-23:
349 subagent transcripts, 15747 requests, **19.6% of all tokens**. A funnel run
dispatches five agents, so that is the number that says what a stage costs before
you decide which model it should run.

`--since` and `--until` cut on each request's own day rather than on the file's, so
a session that spans a release does not land wholly on one side of it. `--by-stage`
splits the subagent lane by funnel stage and prints the cost per execution beside
the total, which is the pair that says whether a stage is worth the model it runs.
Together they answer "did the change to the funnel pay", which was a hand-written
script until 0.10.0:

    kit usage --all --since 2026-08-04 --until 2026-08-16 --by-stage
    kit usage --all --since 2026-08-17 --until 2026-08-29 --by-stage

`--project DIR` reads every transcript of that directory, and an explicit flag wins
over `CLAUDE_CODE_SESSION_ID`. Until 0.15.0 the variable won, so the same command run
inside a session answered for that one session whatever directory it was given.
`--by-session` prints one row per session with its branch, which is the cost per task
wherever a task is one session, as it is in the lite lane.

A pull request is rarely one session. Measured 2026-10-19 over the week before, one
branch ran in 12 sessions, so `--by-branch` sums them into one row per branch, which
is the cost per pull request. Every row and lane also carries `cache%`, the share of
input tokens read from cache, because a prefix written and never read again is where
a session pays without noticing.

The rates and the request de-duplication come from `scripts/context`, imported rather
than copied, because a second copy of a rule is the defect this plugin shipped in
`no-em-dash` until 0.9.2. Those rates became per-model in 0.10.0: a single Opus rate
was close enough while every agent inherited the main loop's model, and it stopped
being close enough when the test writer and the reviewer moved to Sonnet.
"""

import argparse
import glob
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys


def load_context():
    """`scripts/context` has no .py extension, so it is loaded by path."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "context")
    loader = importlib.machinery.SourceFileLoader("kit_context", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


CTX = load_context()


def blank():
    return {"input": 0, "output": 0, "cache_write": 0, "cache_read": 0,
            "requests": 0, "cost": 0.0}


def add(out, usage):
    out["requests"] += 1
    out["input"] += usage.get("input_tokens", 0)
    out["output"] += usage.get("output_tokens", 0)
    out["cache_write"] += usage.get("cache_creation_input_tokens", 0)
    out["cache_read"] += usage.get("cache_read_input_tokens", 0)
    # Priced per request rather than on the summed totals, because the sum spans
    # models: since 0.10.0 the test writer and the reviewer run Sonnet while the
    # implementer and the triage inherit Opus, and one rate over the lot reports a
    # Sonnet stage at about 2.5 times what it cost.
    out["cost"] += CTX.cost(usage)
    return out


def finish(out):
    out["tokens"] = out["input"] + out["output"] + out["cache_write"] + out["cache_read"]
    prompt = out["input"] + out["cache_write"] + out["cache_read"]
    out["cache_read_pct"] = round(100.0 * out["cache_read"] / prompt, 1) if prompt else 0.0
    return out


def in_window(usage, since, until):
    """Filter by the request's own day, not by the file's.

    A session that spans a release is the ordinary case here, so a whole-file filter
    would put every request of it on one side of the boundary.
    """
    if not (since or until):
        return True
    day = (usage.get("_ts") or "")[:10]
    if not day:
        return False
    return (not since or day >= since) and (not until or day <= until)


def totals(paths, since=None, until=None):
    """Summed usage over a set of transcripts, deduplicated the way context does."""
    out = blank()
    for path in paths:
        for usage in CTX.read_usage(path):
            if in_window(usage, since, until):
                add(out, usage)
    return finish(out)


# The stage a subagent transcript belongs to, read from the opening of the first
# user message, which is the dispatch prompt verbatim. Not from the file name or a
# field: the harness names these after an opaque agent id and records no agent type.
#
# So this is a heuristic, and `other` is a real bucket rather than a rounding error:
# a dispatch written before the stage names settled, or written in the wrong
# language, lands there. Read it as "how much went to agents this cannot name", and
# a large one is worth opening rather than dividing away. Order matters, because a
# screen lens prompt names stage 4 too.
STAGES = (
    ("screen lens", "4 screen-lens"),
    ("screen-lens", "4 screen-lens"),
    ("stage 4", "4 reviewer"),
    ("adversarial review", "4 reviewer"),
    ("revisao adversarial", "4 reviewer"),
    ("stage 3", "3 test-writer"),
    ("test writer", "3 test-writer"),
    ("stage 2", "2 implementer"),
    ("stage 1", "1 triage"),
    ("triage and spec", "1 triage"),
)
HEAD_CHARS = 1500

# The funnel's own agents, by the type the harness writes beside each subagent
# transcript. Exact where the prompt heuristic above is a guess, so it is read first.
AGENT_STAGES = {
    "funnel-triage": "1 triage",
    "funnel-implementer": "2 implementer",
    "funnel-test-writer": "3 test-writer",
    "funnel-reviewer": "4 reviewer",
    "funnel-screen-lens": "4 screen-lens",
}


def agent_type(path):
    meta = path[: -len(".jsonl")] + ".meta.json"
    try:
        with open(meta, errors="ignore") as handle:
            return json.load(handle).get("agentType") or ""
    except (OSError, ValueError, AttributeError):
        return ""


def stage_of(path):
    known = AGENT_STAGES.get(agent_type(path).rsplit(":", 1)[-1])
    if known:
        return known
    try:
        with open(path, errors="ignore") as handle:
            for line in handle:
                row = json.loads(line) if line.strip() else {}
                if row.get("type") != "user":
                    continue
                content = row.get("message", {}).get("content")
                text = content if isinstance(content, str) else json.dumps(content)
                head = text[:HEAD_CHARS].lower()
                for needle, name in STAGES:
                    if needle in head:
                        return name
                return "other"
    except (OSError, ValueError):
        pass
    return "other"


def by_stage(sub_files, since=None, until=None):
    """Per funnel stage: what it spent, and how many times it ran.

    The count is transcripts, which is executions: one dispatch, one transcript. It
    is the number the fan-out rules are written against, and the per-execution cost
    beside it is what says whether a stage is worth the model it runs.
    """
    out = {}
    for path in sub_files:
        name = stage_of(path)
        row = out.setdefault(name, blank())
        row.setdefault("runs", 0)
        counted = False
        for usage in CTX.read_usage(path):
            if in_window(usage, since, until):
                add(row, usage)
                counted = True
        if counted:
            row["runs"] += 1
    return {k: finish(v) for k, v in out.items() if v["requests"]}


def lanes(main_files):
    """(main transcripts, the subagent transcripts belonging to them)."""
    subs = []
    for path in main_files:
        stem = path[: -len(".jsonl")]
        subs.extend(sorted(glob.glob(os.path.join(stem, "subagents", "*.jsonl"))))
    return main_files, subs


def first_branch(path):
    """The first git branch a transcript recorded, which names the task it ran."""
    try:
        with open(path, errors="ignore") as handle:
            for line in handle:
                branch = (json.loads(line) if line.strip() else {}).get("gitBranch")
                if branch and branch != "HEAD":
                    return branch
    except (OSError, ValueError):
        pass
    return ""


def by_session(main_files, since=None, until=None):
    """One row per session, its agents included, oldest first."""
    rows = []
    for path in main_files:
        stem = path[: -len(".jsonl")]
        subs = sorted(glob.glob(os.path.join(stem, "subagents", "*.jsonl")))
        days = sorted(u["_ts"][:10] for u in CTX.read_usage(path) if u.get("_ts"))
        row = totals([path] + subs, since, until)
        if not row["requests"]:
            continue
        row.update(session=os.path.basename(stem)[:8], branch=first_branch(path),
                   day=days[0] if days else "", agents=len(subs))
        rows.append(row)
    return sorted(rows, key=lambda r: r["day"])


def by_branch(sessions):
    """The sessions summed per branch, most expensive first."""
    out = {}
    for session in sessions:
        row = out.setdefault(session["branch"] or "-", dict(blank(), sessions=0, agents=0))
        for key in ("input", "output", "cache_write", "cache_read", "requests", "cost", "agents"):
            row[key] += session[key]
        row["sessions"] += 1
    rows = [dict(finish(row), branch=name) for name, row in out.items()]
    return sorted(rows, key=lambda r: -r["cost"])


def load_prices(where):
    """The repo config's `prices`, installed as overrides on the shared rate table.

    Read through funnel-config so the config is found the same way every other
    command finds it, including from a worktree whose config was never committed.
    """
    tool = os.path.join(os.path.dirname(os.path.abspath(__file__)), "funnel-config")
    try:
        out = subprocess.run([tool, "get", ".prices"], cwd=where, capture_output=True,
                             text=True, timeout=20).stdout.strip()
        table = json.loads(out) if out else {}
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0
    for key, rate in (table or {}).items():
        base = float(rate["in"])
        CTX.OVERRIDES[key] = {"in": base, "out": float(rate["out"]),
                              "cw": float(rate.get("cw", base * 1.25)),
                              "cr": float(rate.get("cr", base * 0.1))}
    return len(CTX.OVERRIDES)


def resolve(cfg, args):
    if args.all:
        return sorted(glob.glob(os.path.join(cfg, "projects", "*", "*.jsonl"))), "every project"
    # An explicit flag names what to read. The environment only says where this
    # command happens to be running, so it answers last.
    if args.session:
        hit = CTX.find_session(cfg, args.session)
        if hit:
            return [hit], "session " + args.session[:8]
        return [], "session " + args.session[:8] + ", no transcript"
    if args.project:
        project = os.path.join(cfg, "projects", CTX.slug_for(os.path.abspath(args.project)))
        files = sorted(glob.glob(os.path.join(project, "*.jsonl")))
        return files, "every transcript for " + args.project
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if session:
        hit = CTX.find_session(cfg, session)
        if hit:
            return [hit], "session " + session[:8]
        return [], "session " + session[:8] + ", no transcript"
    project = os.path.join(cfg, "projects", CTX.slug_for(os.getcwd()))
    newest = CTX.newest_transcript(project)
    if newest:
        return [newest], "newest transcript for this directory"
    return [], "no transcript for this directory"


def main(argv):
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--session")
    ap.add_argument("--project")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--since", metavar="YYYY-MM-DD")
    ap.add_argument("--until", metavar="YYYY-MM-DD")
    ap.add_argument("--by-stage", action="store_true")
    ap.add_argument("--by-session", action="store_true")
    ap.add_argument("--by-branch", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args(argv)
    if args.help:
        print(__doc__.strip())
        return 0
    for flag, value in (("--since", args.since), ("--until", args.until)):
        if value and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", value):
            print("%s takes YYYY-MM-DD, got %r" % (flag, value), file=sys.stderr)
            return 2

    cfg = os.environ.get("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude"))
    overrides = load_prices(args.project or os.getcwd())
    main_files, scope = resolve(cfg, args)
    if not main_files:
        print("no transcript found: %s" % scope)
        return 1

    main_files, sub_files = lanes(main_files)
    m = totals(main_files, args.since, args.until)
    s = totals(sub_files, args.since, args.until)
    total_tokens = m["tokens"] + s["tokens"]
    share = 100.0 * s["tokens"] / total_tokens if total_tokens else 0.0
    stages = by_stage(sub_files, args.since, args.until) if args.by_stage else None
    wants_sessions = args.by_session or args.by_branch
    session_rows = by_session(main_files, args.since, args.until) if wants_sessions else None
    sessions = session_rows if args.by_session else None
    branches = by_branch(session_rows) if args.by_branch else None
    if args.since or args.until:
        scope += ", %s to %s" % (args.since or "the beginning", args.until or "today")
    if overrides:
        scope += ", %d price override(s) from the repo config" % overrides

    if args.json:
        payload = {"scope": scope, "main": m, "subagents": s,
                   "subagent_share_pct": round(share, 1),
                   "subagent_transcripts": len(sub_files)}
        if stages is not None:
            payload["stages"] = stages
        if sessions is not None:
            payload["sessions"] = sessions
        if branches is not None:
            payload["branches"] = branches
        json.dump(payload, sys.stdout, indent=2)
        print()
        return 0

    print("scope: %s" % scope)
    print("%-11s %13s %12s %10s %7s" % ("lane", "tokens", "requests", "US$", "cache%"))
    print("%-11s %13d %12d %10.2f %7.1f"
          % ("main", m["tokens"], m["requests"], m["cost"], m["cache_read_pct"]))
    print("%-11s %13d %12d %10.2f %7.1f  (%d transcripts)"
          % ("subagents", s["tokens"], s["requests"], s["cost"], s["cache_read_pct"],
             len(sub_files)))
    print("subagents are %.1f%% of the tokens" % share)
    if stages:
        print("\n%-16s %6s %10s %10s" % ("stage", "runs", "US$", "US$/run"))
        for name in sorted(stages, key=lambda k: -stages[k]["cost"]):
            row = stages[name]
            per = row["cost"] / row["runs"] if row["runs"] else 0.0
            print("%-16s %6d %10.2f %10.2f" % (name, row["runs"], row["cost"], per))
    if sessions:
        print("\n%-10s %-9s %6s %8s %10s  %s" % ("day", "session", "agents", "Mtok", "US$", "branch"))
        for row in sessions:
            print("%-10s %-9s %6d %8.1f %10.2f  %s" % (
                row["day"], row["session"], row["agents"], row["tokens"] / 1e6,
                row["cost"], row["branch"] or "-"))
        spent = sum(r["cost"] for r in sessions)
        print("%d session(s), US$ %.2f each on average" % (len(sessions), spent / len(sessions)))
    if branches:
        print("\n%8s %6s %8s %10s %7s  %s"
              % ("sessions", "agents", "Mtok", "US$", "cache%", "branch"))
        for row in branches:
            print("%8d %6d %8.1f %10.2f %7.1f  %s" % (
                row["sessions"], row["agents"], row["tokens"] / 1e6, row["cost"],
                row["cache_read_pct"], row["branch"]))
        spent = sum(r["cost"] for r in branches)
        print("%d branch(es), US$ %.2f each on average" % (len(branches), spent / len(branches)))
    print("\nList price, not what a subscription charges. The split is the number to"
          "\nread: it is what a stage costs before you decide which model it runs.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
