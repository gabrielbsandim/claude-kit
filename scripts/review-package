#!/usr/bin/env bash
# Builds the exact package one review lens reads, and nothing else.
#
#   review-package --plan <light|standard|deep> [--since <sha>]
#   review-package <lens> [--since <sha>]
#   review-package --disjoint <lensA> <lensB>
#
# Why this exists: two thirds of a typical diff is test code, so an unscoped
# `git diff base...HEAD` made four of five lenses read ~1900 lines that only one
# of them had a use for. And the doc load is worse than the diff: a blanket
# "read architecture, conventions, frontend, testing" is 18.5k tokens before the
# agent opens a file, paid once per lens, at the most expensive tier in the run.
#
# The diff is written to a file under .git so a lens reads instead of running git,
# and so it cannot be committed by accident.
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CFG="$BIN_DIR/funnel-config"
REPO_ROOT="$("$CFG" root)"
OUT="$(git rev-parse --absolute-git-dir)/claude-kit/review"
mkdir -p "$OUT"

die() { printf '%s\n' "$*" >&2; exit 1; }

since=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --since) since="$2"; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- ${args[@]+"${args[@]}"}

slice_range() {
  local spec="$1"
  # A fix round reviews the fix, not the branch again. Same paths, new range.
  if [ -n "$since" ]; then
    printf '%s' "${spec/#*...HEAD/$since..HEAD}"
  else
    printf '%s' "$spec"
  fi
}

write_named_slice() {
  local name="$1" spec range file tag
  spec="$("$CFG" get ".slices.\"$name\"")"
  [ -n "$spec" ] || die "no slice named \"$name\""
  range="$(slice_range "$spec")"
  # The range is part of the filename, and the write lands by rename. Without
  # either, a first-round package and a `--since` fix-round package share one path:
  # the second `>` truncates at open, and a reviewer already reading it reviews a
  # truncated diff with no error to show for it. Four of the seven lenses in the
  # template share the slice "src", so this path is contended by construction.
  tag="$(printf '%s' "$range" | git hash-object --stdin | cut -c1-8)"
  file="$OUT/slice-$name.$tag.diff"
  # shellcheck disable=SC2086
  ( cd "$REPO_ROOT" && eval "git diff --stat=200 $range && echo && git diff -U8 $range" ) >"$file.$$"
  mv -f "$file.$$" "$file"
  printf '%s' "$file"
}

write_slice() {
  local name
  name="$("$CFG" get ".lenses.\"$1\".slice")"
  [ -n "$name" ] || die "lens \"$1\" names no slice"
  write_named_slice "$name"
}

# Prose that this change may have falsified. Candidates, not findings: the tokens
# are declaration names and multi-digit literals from the changed lines, which is
# how a comment keeps claiming 16 MB after the code moved to 1 MB.
claims_candidates() {
  local spec range tokens targets
  spec="$("$CFG" get '.slices.all')"
  range="$(slice_range "$spec")"
  tokens="$( cd "$REPO_ROOT" && eval "git diff -U0 $range" \
    | grep -E '^[+-]' | grep -Ev '^(\+\+\+|---)' \
    | grep -oE '(function|const|let|class|type|interface|enum|def|func) +[A-Za-z_][A-Za-z0-9_]*|[0-9]{2,}' \
    | awk '{print $NF}' | sort -u | grep -Ev '^(0+|1[0-9]{3}|20[0-9]{2})$' | head -40 )"
  [ -n "$tokens" ] || return 0
  targets="$("$CFG" get '.lenses.claims.grepTargets[]?' | tr '\n' ' ')"
  [ -n "$targets" ] || return 0
  ( cd "$REPO_ROOT" && printf '%s\n' "$tokens" \
      | while IFS= read -r t; do
          [ -z "$t" ] && continue
          # `|| true` because a token that matches no prose is the ordinary case,
          # not a failure. Under `set -o pipefail` the grep's 1 became the
          # pipeline's status and `set -e` killed the whole plan mid-print: the
          # dispatch lines were already on stdout, so a claims lens whose
          # candidates matched nothing printed a plan with its count line missing
          # and exit 1 attached, which reads as a plan rather than as an error.
          grep -rInF --exclude-dir=node_modules -- "$t" $targets 2>/dev/null | head -4 || true
        done ) | sort -u | head -60
}

# The files the diff touches, for a lens that reads them whole rather than as
# hunks. `git diff -U8` shows eight lines around a change, and the consequence of
# a change is routinely further away than that inside the very same file: on pull
# request 880 a value hardcoded to 0 silenced a warning rendered 200 lines below
# it, inside a file every lens had already "read".
changed_files() {
  local spec range bytes
  # The lens's own slice, not `all`: a lens whose slice already excludes the test
  # tree should not spend its read budget on files another lens has the diff for.
  spec="$("$CFG" get ".slices.\"$("$CFG" get ".lenses.\"$1\".slice")\"")"
  range="$(slice_range "$spec")"
  # Ranked by how much of each file the change rewrote, because the cap cuts
  # somewhere and alphabetical order decides that by directory name.
  ( cd "$REPO_ROOT" && eval "git diff --numstat $range" ) \
    | awk '{ a=($1=="-")?0:$1; d=($2=="-")?0:$2; printf "%d\t%s\n", a+d, $3 }' \
    | sort -rn | head -25 | cut -f2- \
    | while IFS= read -r f; do
        bytes=0
        [ -f "$REPO_ROOT/$f" ] && bytes="$(wc -c <"$REPO_ROOT/$f")"
        # A file this size is prose or a generated table, and reading it whole is
        # the cost the claims lens exists to avoid paying: it gets grep-precomputed
        # candidates for the same file instead. Naming the skip beats a silent one,
        # because a lens told to read "every file below" and handed a list with a
        # gap in it will go and open the gap.
        if [ "$bytes" -gt 40000 ]; then
          printf '%s   SKIPPED at %s bytes, the claims lens has this one\n' "$f" "$bytes"
        else
          printf '%s   (%s bytes)\n' "$f" "$bytes"
        fi
      done
}

reads_outside() {
  case "$("$CFG" get ".lenses.\"$1\".readsOutsideDiff?" 2>/dev/null || true)" in
    true) return 0 ;;
    *)    return 1 ;;
  esac
}

# The callers of what the diff changed. Every lens but this one is forbidden to
# open a file the diff does not contain, and that discipline is what a slice lens
# costs its price for. It is also what the diff cannot show: a default written to
# silence a warning the caller still renders, an argument the new signature ignores,
# a column narrower than the value the new code writes to it. Measured on pull
# requests 879 and 880, eight of eight findings an outside reviewer would not let
# through were of exactly this shape, and no slice lens had reached any of them.
#
# So the permission is granted once, and paid for with grep instead of a sweep:
# the declarations the diff added, resolved to the files outside the diff that
# name them. A list of files, capped, not a codebase.
consumers_candidates() {
  local spec range names changed targets excl
  spec="$("$CFG" get '.slices.all')"
  range="$(slice_range "$spec")"
  targets="$("$CFG" get '.lenses.consequences.codeTargets[]?' | tr '\n' ' ')"
  [ -n "${targets// /}" ] || return 0
  changed="$( cd "$REPO_ROOT" && eval "git diff --name-only $range" | sort -u )"
  # Exported declarations only, and every local `const result` drops out with them.
  # Measured on the merge of pull request 880: the unfiltered form yielded 40 names,
  # of which `result`, `hours`, `rate` and `order` matched most of the repository and
  # ranked `prisma/schema.prisma` first; the exported form yielded 12, one of them
  # the `pickCostSnapshot` that was finding number two on that pull request.
  names="$( cd "$REPO_ROOT" && eval "git diff -U0 $range" \
    | grep -E '^\+' | grep -v '^+++' \
    | grep -oE 'export +(default +)?(async +)?(function|const|class|type|interface|enum) +[A-Za-z_][A-Za-z0-9_]{3,}' \
    | awk '{print $NF}' | sort -u | head -30 )"
  # A change that exports nothing new still has callers, so fall back to every
  # declaration rather than returning an empty list and reading as "no consumers".
  if [ -z "$names" ]; then
    names="$( cd "$REPO_ROOT" && eval "git diff -U0 $range" \
      | grep -E '^\+' | grep -v '^+++' \
      | grep -oE '(function|class|type|interface|enum) +[A-Za-z_][A-Za-z0-9_]{5,}' \
      | awk '{print $NF}' | sort -u | head -30 )"
  fi
  [ -n "$names" ] || return 0
  excl="$(mktemp)"; printf '%s\n' "$changed" >"$excl"
  # `|| true` for the same reason claims_candidates has it: a declaration nothing
  # else references is the ordinary case, and under pipefail its grep would take
  # the whole plan down mid-print.
  # Ranked by how many of the changed declarations each file references, not
  # alphabetically. A cap has to cut somewhere, and the file that uses five of them
  # is the one whose behaviour the change is most likely to have altered; sorting by
  # name instead spends the whole budget in whichever directory sorts first.
  ( cd "$REPO_ROOT" && printf '%s\n' "$names" \
      | while IFS= read -r t; do
          [ -z "$t" ] && continue
          # A name matching half the repository is a word, not a reference, and it
          # would spend the whole cap on files that merely contain it.
          hits="$(grep -rIlF --exclude-dir=node_modules -- "$t" $targets 2>/dev/null | sort -u || true)"
          count="$(printf '%s\n' "$hits" | grep -c . || true)"
          [ "$count" -eq 0 ] || [ "$count" -gt 15 ] || printf '%s\n' "$hits"
        done ) | grep -vxF -f "$excl" | sort | uniq -c | sort -rn | head -25 \
    | awk '{printf "%s   (%s of the changed names)\n", $2, $1}'
  rm -f "$excl"
}

case "${1:-}" in
  --disjoint)
    a="${2:?}"; b="${3:?}"
    fa="$(mktemp)"; fb="$(mktemp)"
    sa="$("$CFG" get ".slices.\"$("$CFG" get ".lenses.\"$a\".slice")\"")"
    sb="$("$CFG" get ".slices.\"$("$CFG" get ".lenses.\"$b\".slice")\"")"
    ( cd "$REPO_ROOT" && eval "git diff --name-only $(slice_range "$sa")" ) | sort >"$fa"
    ( cd "$REPO_ROOT" && eval "git diff --name-only $(slice_range "$sb")" ) | sort >"$fb"
    overlap="$(comm -12 "$fa" "$fb")"
    printf '%s: %s file(s)\n%s: %s file(s)\n' "$a" "$(wc -l <"$fa")" "$b" "$(wc -l <"$fb")"
    if [ -z "$overlap" ]; then
      printf 'disjoint, safe to run in parallel\n'
    else
      printf 'OVERLAP:\n%s\n' "$overlap"
    fi
    rm -f "$fa" "$fb"
    ;;

  --plan)
    level="${2:?usage: review-package --plan <light|standard|deep>}"
    lenses="$("$CFG" get ".effort.\"$level\"[]?")"
    [ -n "$lenses" ] || die "no effort level \"$level\" in the config"
    printf 'effort %s%s\n\n' "$level" "${since:+, fix round since ${since:0:8}}"
    for l in $lenses; do
      f="$(write_slice "$l")"
      lines="$(grep -c '^[+-]' "$f" || true)"
      printf '%-14s %s\n%-14s %s changed line(s)\n' "$l" "$f" "" "$lines"
    done
    printf '\nmax %s concurrent dispatches (config maxParallelAgents)\n' "$("$CFG" get .maxParallelAgents)"
    ;;

  # One dispatch per slice, carrying every lens that reads that slice as a
  # numbered part of one contract. Fan-out per lens was measured and removed:
  # two reviewer prompts fused into one that returns "Part 1 spec conformity,
  # Part 2 code quality" from a single read of the same diff ran twice as fast
  # for about half the tokens. Grouping by slice is the version of that finding
  # that keeps independent contexts where the material actually differs.
  --dispatches)
    level="${2:?usage: review-package --dispatches <light|standard|deep>}"
    lenses="$("$CFG" get ".effort.\"$level\"[]?")"
    [ -n "$lenses" ] || die "no effort level \"$level\" in the config"
    slices="" solo=""
    for l in $lenses; do
      # A lens allowed to read outside the diff cannot share a dispatch with one
      # that is not: the two carry contradictory reading disciplines, and the
      # looser one is the one an agent follows.
      if reads_outside "$l"; then solo="$solo $l"; continue; fi
      s="$("$CFG" get ".lenses.\"$l\".slice")"
      printf '%s\n' "$slices" | grep -qxF "$s" || slices="$slices$s"$'\n'
    done
    model="$("$CFG" get ".reviewModel.\"$level\"?" 2>/dev/null || true)"
    case "$model" in null|"") model="" ;; esac
    n=0
    printf 'effort %s%s\n' "$level" "${since:+, fix round since ${since:0:8}}"
    # What the orchestrator must not write. The reading discipline, the grading
    # rubric, CONFIRMED against PLAUSIBLE and the return shape are all in
    # `agents/funnel-reviewer.md`, so a dispatch that restates them pays for
    # prompt that changes no behaviour. Measured on pull request 911: four
    # dispatches of 60 to 100 lines each, about 35 lines per dispatch already
    # carried by the agent. It is printed here and not left to memory because
    # the mistake is made at the moment of writing the prompt, which is this
    # output's only reader.
    printf '\nsend    each block below verbatim, plus only this task'"'"'s half: what the\n'
    printf '        change is for, the acceptance criteria, and what was deliberately\n'
    printf '        left out. The agent already carries the reading discipline, the\n'
    printf '        rubric, CONFIRMED against PLAUSIBLE and the return format.\n'
    for s in $slices; do
      [ -z "$s" ] && continue
      n=$((n + 1))
      group="" docs=""
      for l in $lenses; do
        [ "$("$CFG" get ".lenses.\"$l\".slice")" = "$s" ] || continue
        # It names this slice, but it is dispatched alone below. Without this it
        # would be listed here as well and reviewed twice, once under a discipline
        # that contradicts its own.
        reads_outside "$l" && continue
        group="$group $l"
        while IFS= read -r d; do
          [ -z "$d" ] && continue
          printf '%s\n' "$docs" | grep -qxF "$d" || docs="$docs$d"$'\n'
        done < <("$CFG" get ".lenses.\"$l\".docs[]?")
      done
      f="$(write_named_slice "$s")"
      lines="$(grep -c '^[+-]' "$f" || true)"
      # A fix round reviews the fix. A slice the fix never touched has nothing in
      # it, and a reviewer dispatched at an empty diff still pays a full cold
      # context to report that there is nothing to report. First round always
      # dispatches, because an empty slice there is a fact the reviewer's absence
      # would hide.
      if [ -n "$since" ] && [ "$lines" -eq 0 ]; then
        n=$((n - 1))
        printf '\nskipped     parts:%s\n' "$group"
        printf '  the fix since %s touched nothing in slice "%s"\n' "${since:0:8}" "$s"
        continue
      fi
      docbytes=0
      for d in $docs; do
        [ -f "$REPO_ROOT/$d" ] && docbytes=$((docbytes + $(wc -c <"$REPO_ROOT/$d")))
      done
      printf '\ndispatch %s   parts:%s\n' "$n" "$group"
      # The reviewer's model is its frontmatter, and a dispatch that writes one
      # itself silently overrides it. The one legitimate override is an escalation
      # this repo asked for by effort level, so it is printed here rather than
      # remembered: with no `reviewModel` entry nothing prints and nothing is passed.
      [ -n "$model" ] && printf '  model %s   (config reviewModel.%s; pass it, and pass nothing otherwise)\n' "$model" "$level"
      printf '  diff  %s  (%s changed lines)\n' "$f" "$lines"
      if [ -n "${docs// /}" ]; then
        printf '  read  %s  (%s bytes)\n' "$(printf '%s' "$docs" | tr '\n' ' ')" "$docbytes"
      else
        printf '  read  nothing beyond the diff\n'
      fi
      case " $group " in
        *" claims "*)
          printf '  prose candidates (grep-precomputed):\n'
          c="$(claims_candidates)"
          if [ -n "$c" ]; then printf '%s\n' "$c" | sed 's/^/    /'; else printf '    none matched\n'; fi
          ;;
      esac
    done
    for l in $solo; do
      f="$(write_slice "$l")"
      lines="$(grep -c '^[+-]' "$f" || true)"
      if [ -n "$since" ] && [ "$lines" -eq 0 ]; then
        printf '\nskipped     parts: %s\n' "$l"
        printf '  the fix since %s touched nothing this lens reads\n' "${since:0:8}"
        continue
      fi
      n=$((n + 1))
      printf '\ndispatch %s   parts: %s   (alone: reads outside the diff)\n' "$n" "$l"
      [ -n "$model" ] && printf '  model %s   (config reviewModel.%s; pass it, and pass nothing otherwise)\n' "$model" "$level"
      printf '  diff  %s  (%s changed lines)\n' "$f" "$lines"
      printf '  read  every file below in full, and nothing else outside the diff\n'
      printf '  touched by the diff, to be read whole and not as hunks:\n'
      changed_files "$l" | sed 's/^/    /'
      printf '  callers outside the diff (grep-precomputed, ranked):\n'
      c="$(consumers_candidates)"
      if [ -n "$c" ]; then printf '%s\n' "$c" | sed 's/^/    /'; else printf '    none matched: nothing outside the diff references what it exports\n'; fi
    done
    printf '\n%s dispatch(es), max %s concurrent\n' "$n" "$("$CFG" get .maxParallelAgents)"
    ;;

  "" ) die "usage: review-package --plan <level> | <lens> | --disjoint <a> <b>" ;;

  *)
    lens="$1"
    "$CFG" lens "$lens" >/dev/null
    file="$(write_slice "$lens")"
    lines="$(grep -c '^[+-]' "$file" || true)"
    printf 'lens     %s\n' "$lens"
    printf 'diff     %s   (%s changed lines, already written, do not run git)\n' "$file" "$lines"
    docs="$("$CFG" get ".lenses.\"$lens\".docs[]?" | tr '\n' ' ')"
    if [ -n "${docs// /}" ]; then
      printf 'read     %s\n' "$docs"
    else
      printf 'read     nothing beyond the diff\n'
    fi
    if [ "$lens" = claims ]; then
      printf 'prose candidates (grep-precomputed, verify each against the code as committed):\n'
      c="$(claims_candidates)"
      if [ -n "$c" ]; then printf '%s\n' "$c"; else printf '  none matched\n'; fi
    fi
    if reads_outside "$lens"; then
      printf 'read in full (not as hunks), because the consequence is routinely\n'
      printf 'further from the change than the diff context reaches:\n'
      changed_files "$lens" | sed 's/^/  /'
      printf 'callers outside the diff (grep-precomputed, ranked). Open these, and\n'
      printf 'nothing else outside the diff:\n'
      c="$(consumers_candidates)"
      if [ -n "$c" ]; then printf '%s\n' "$c" | sed 's/^/  /'; else printf '  none matched: nothing outside the diff references what it exports\n'; fi
    fi
    ;;
esac
