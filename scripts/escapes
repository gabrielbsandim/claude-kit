#!/usr/bin/env python3
"""Which merged pull requests needed a fix soon after, by lane and by month.

    kit escapes [--days 90] [--window 14] [--hot 20] [--exclude GLOB]... [--json]
    kit escapes --case N [--out DIR]     an eval case skeleton for the escape of #N
    kit escapes --from FILE              read `gh pr list` JSON instead of calling gh

A review's own findings say what the review saw, never what it missed. What it
missed shows up later, as a pull request that fixes the same files. So an escape is
a merged pull request P followed, within `--window` days of its merge, by a merged
pull request Q that is a fix or a revert and shares at least one source file with P.

Two things make the raw count lie, and both were measured on the repository this
was written against. A file that most pull requests touch (a help corpus, a
registry) shares itself with everything: two such files sat in about 200 of 400
pull requests each, so any file touched by `--hot` or more pull requests in the
sample does not count as shared. And tests, documentation and migrations move with
every fix by design, so they are excluded unless `--exclude` replaces the list.

The lane comes from the marker the task skill writes into the body at ship time,
`<!-- funnel: direct -->` or `<!-- funnel: risk -->`. A pull request without one is
`none`: work that did not go through the funnel, which is the comparison that says
whether the funnel is paying.
"""
import datetime as dt
import fnmatch
import json
import os
import re
import subprocess
import sys
from collections import Counter, defaultdict

FIELDS = "number,title,mergedAt,headRefName,body,files,url"
DEFAULT_EXCLUDE = ["*test*", "*spec*", "docs/*", "*.md", "*/migrations/*", "prisma/*",
                   "*lock.json", "*.lock", "*lock.yaml", "CHANGELOG*"]
FIX = re.compile(r"^(fix|hotfix|revert)\b", re.I)
LANE = re.compile(r"<!--\s*funnel:\s*(direct|risk)\s*-->")


def arg(argv, name, default=None):
    return argv[argv.index(name) + 1] if name in argv else default


def load(argv):
    source = arg(argv, "--from")
    if source:
        with open(source) as fh:
            return json.load(fh)
    since = (dt.date.today() - dt.timedelta(days=int(arg(argv, "--days", "90")))).isoformat()
    out = subprocess.run(["gh", "pr", "list", "--state", "merged", "--limit", "1000",
                          "--search", "merged:>=" + since, "--json", FIELDS],
                         capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(out.stderr.strip() or "gh pr list failed")
    return json.loads(out.stdout)


def merged(pr):
    return dt.datetime.fromisoformat(pr["mergedAt"].replace("Z", "+00:00"))


def is_fix(pr):
    branch = pr.get("headRefName") or ""
    return bool(FIX.match(pr.get("title") or "")) or branch.startswith(("fix/", "hotfix/"))


def reverts(q, p):
    title = q.get("title") or ""
    if not title.lower().startswith("revert"):
        return False
    return f"#{p['number']}" in title + (q.get("body") or "") or (p.get("title") or "") in title


def lane(pr):
    found = LANE.search(pr.get("body") or "")
    return found.group(1) if found else "none"


def files(pr):
    return {f["path"] for f in pr.get("files") or [] if f.get("path")}


def find(prs, window, hot, exclude):
    prs = sorted((p for p in prs if p.get("mergedAt")), key=merged)
    touched = Counter(f for p in prs for f in files(p))
    hot_files = {f for f, n in touched.items() if n >= hot}

    def counts(path):
        return path not in hot_files and not any(fnmatch.fnmatch(path, g) for g in exclude)

    escapes = []
    for i, p in enumerate(prs):
        mine = {f for f in files(p) if counts(f)}
        for q in prs[i + 1:]:
            if merged(q) - merged(p) > dt.timedelta(days=window):
                break
            if reverts(q, p):
                escapes.append((p, q, ["reverted"]))
                break
            shared = sorted(mine & files(q)) if is_fix(q) else []
            if shared:
                escapes.append((p, q, shared))
                break
    return prs, escapes, hot_files


def report(prs, escapes, hot_files, as_json):
    escaped = {p["number"] for p, _, _ in escapes}
    by_lane, by_month = defaultdict(lambda: [0, 0]), defaultdict(lambda: [0, 0])
    for p in prs:
        for table, key in ((by_lane, lane(p)), (by_month, (lane(p), p["mergedAt"][:7]))):
            table[key][0] += 1
            table[key][1] += p["number"] in escaped
    rows = [{"from": p["number"], "lane": lane(p), "fixedBy": q["number"], "title": q["title"],
             "shared": shared} for p, q, shared in escapes]
    if as_json:
        print(json.dumps({"lanes": {k: {"prs": v[0], "escaped": v[1]} for k, v in by_lane.items()},
                          "months": [{"lane": k[0], "month": k[1], "prs": v[0], "escaped": v[1]}
                                     for k, v in sorted(by_month.items())],
                          "escapes": rows, "hotFiles": sorted(hot_files)}, indent=2))
        return 0
    print(f"{'lane':<8} {'PRs':>5} {'escaped':>8} {'rate':>6}")
    for key in ("direct", "risk", "none"):
        n, e = by_lane.get(key, (0, 0))
        if n:
            print(f"{key:<8} {n:>5} {e:>8} {e / n:>6.0%}")
    print(f"\n{'month':<8} {'lane':<8} {'PRs':>5} {'escaped':>8}")
    for (key, month), (n, e) in sorted(by_month.items(), key=lambda kv: (kv[0][1], kv[0][0])):
        print(f"{month:<8} {key:<8} {n:>5} {e:>8}")
    print(f"\n{len(rows)} escape(s), {len(hot_files)} hot file(s) not counted as shared")
    for r in rows:
        print(f"  #{r['from']} ({r['lane']}) -> #{r['fixedBy']} {r['title'][:60]}  [{', '.join(r['shared'][:3])}]")
    return 0


def skeleton(prs, escapes, number, out):
    match = next(((p, q, s) for p, q, s in escapes if p["number"] == number), None)
    if not match:
        sys.exit(f"#{number} has no escape in this window")
    p, q, shared = match
    name = f"escape-{number}"
    task = (p.get("body") or "").split("\n\n")[0].strip() or p["title"]
    parts = {
        "case.yaml": f'schema_version: "1.0"\nname: {name}\ncontext:\n  scaffold_script: scaffold.sh\n',
        "prompt.md": ("---\n"
                      f"description: The task behind #{p['number']}, which #{q['number']} had to fix\n"
                      "tags: [outcome, escape]\nruns: 2\nmax_turns: 40\ntimeout_seconds: 1500\n"
                      "allowed_tools: [Read, Glob, Grep, Skill, Agent, Bash, Edit, Write]\n"
                      'plugins: ["../.."]\n---\n\n' + task + "\n"),
        "graders/escape-not-repeated.md": (
            "---\ntype: llm\nweight: 3\n---\n\n"
            f"The original change ({p.get('url', '#' + str(p['number']))}) shipped a defect that "
            f"{q.get('url', '#' + str(q['number']))} fixed: {q['title']}.\n"
            f"It lives in: {', '.join(shared)}.\n\n"
            "PASS only if the change the agent made does not carry that defect, or the agent "
            "stopped and named it before writing code. FAIL if the same defect is present.\n"
            "TODO before running: state the defect as an input and the wrong output.\n"),
        "scaffold.sh": ("#!/usr/bin/env bash\nset -e\n"
                        "# TODO: build the smallest repository where the defect can happen, from the\n"
                        f"# files of #{p['number']} at its base commit.\n"),
    }
    if not out:
        for path, body in parts.items():
            print(f"==> {name}/{path}\n{body}")
        return 0
    for path, body in parts.items():
        full = os.path.join(out, name, path)
        os.makedirs(os.path.dirname(full), exist_ok=True)
        with open(full, "w") as fh:
            fh.write(body)
    os.chmod(os.path.join(out, name, "scaffold.sh"), 0o755)
    print(f"wrote {os.path.join(out, name)}: fill the two TODOs, then run it with --case {name}")
    return 0


def main(argv):
    exclude = [argv[i + 1] for i, a in enumerate(argv) if a == "--exclude"] or DEFAULT_EXCLUDE
    prs, escapes, hot_files = find(load(argv), int(arg(argv, "--window", "14")),
                                   int(arg(argv, "--hot", "20")), exclude)
    if "--case" in argv:
        return skeleton(prs, escapes, int(arg(argv, "--case").lstrip("#")), arg(argv, "--out"))
    return report(prs, escapes, hot_files, "--json" in argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
